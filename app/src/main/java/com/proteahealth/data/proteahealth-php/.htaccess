# Keep the original URLs: /api/questions -> api/questions.php
RewriteEngine On
RewriteRule ^api/(questions|answers|tracking|access)/?$ api/$1.php [L,QSA]

# Pass the Authorization header through to PHP on Apache/CGI
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Never serve source/config directly
RewriteRule ^(src|config\.php) - [F,L]
Options -Indexes
