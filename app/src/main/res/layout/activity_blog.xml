<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/blogRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <!-- EVERYTHING INSIDE THIS LAYOUT WILL SCROLL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="20dp">

        <!-- Q&A TITLE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Q &amp; A"
            android:textColor="@color/green"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- SEARCH BAR -->
        <androidx.appcompat.widget.SearchView
            android:id="@+id/search_bar"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/input_background"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            app:queryHint="Search Category" />

        <!-- BANNER -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/banner2"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_marginTop="16dp"
            android:clipChildren="false"
            android:clipToPadding="false" />

        <!-- BANNER DOTS -->
        <LinearLayout
            android:id="@+id/bannerDots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal" />

        <!-- HEALTHCARE TIPS TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:text="Healthcare Tips"
            android:textColor="@color/teal_700"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- ARTICLES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/input_background"
            android:orientation="vertical">

            <ListView
                android:id="@+id/listArticles"
                android:layout_width="match_parent"
                android:layout_height="400dp"
                android:clipToPadding="false"
                android:divider="@android:color/transparent"
                android:dividerHeight="16dp"
                android:nestedScrollingEnabled="false"
                android:paddingStart="20dp"
                android:paddingTop="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp" />

            <Button
                android:id="@+id/edittips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Blog"
            android:textSize="18dp"
            android:textColor="#FF1493"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"/>

        <!-- QUESTION BUTTONS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:paddingBottom="12dp"
            android:background="@drawable/input_background">


            <!-- Questions -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerQuestions"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:clipToPadding="false"/>

            <!-- MY QUESTIONS -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnMyQuestions"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="#E5E5E5"
                android:minHeight="48dp"
                android:text="My questions"
                android:textAllCaps="false"
                android:textColor="#0C514A" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>