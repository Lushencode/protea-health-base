<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:orientation="vertical"

    android:padding="18dp"

    android:layout_marginBottom="14dp"

    android:background="@drawable/input_background">


    <!-- ====================================================== -->
    <!-- PHARMACY NAME + DISTANCE -->
    <!-- ====================================================== -->

    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="horizontal">


        <!-- PHARMACY INFORMATION -->

        <LinearLayout

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:orientation="vertical">


            <!-- PHARMACY NAME -->

            <TextView
                android:id="@+id/tvPharmacyName"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Clicks Pharmacy - Musgrave"

                android:textSize="18sp"
                android:textStyle="bold"

                android:textColor="#222222" />


            <!-- LOCATION -->

            <TextView
                android:id="@+id/tvLocation"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="3dp"

                android:text="Musgrave Centre, Berea, Durban"

                android:textSize="13sp"

                android:textColor="#777777" />

        </LinearLayout>


        <!-- DISTANCE -->

        <TextView
            android:id="@+id/tvDistance"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="1.2 km"

            android:textSize="13sp"
            android:textStyle="bold"

            android:textColor="#159A8C" />

    </LinearLayout>


    <!-- ====================================================== -->
    <!-- DIVIDER -->
    <!-- ====================================================== -->

    <View

        android:layout_width="match_parent"
        android:layout_height="1dp"

        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp"

        android:background="#EEEEEE" />


    <!-- ====================================================== -->
    <!-- MEDICATION NAME -->
    <!-- ====================================================== -->

    <TextView
        android:id="@+id/tvMedicationName"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:text="Metformin 500mg"

        android:textSize="16sp"
        android:textStyle="bold"

        android:textColor="#333333" />


    <!-- ====================================================== -->
    <!-- PRICE & AVAILABILITY -->
    <!-- ====================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="5dp">

        <TextView
            android:id="@+id/tvPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="R185.50"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#E85D75" />

        <TextView
            android:id="@+id/tvAvailability"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="In Stock"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#159A8C" />

    </LinearLayout>

    <!-- ====================================================== -->
    <!-- DELIVERY INFORMATION -->
    <!-- ====================================================== -->

    <TextView
        android:id="@+id/tvDelivery"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Collection only"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#777777" />


    <!-- ====================================================== -->
    <!-- OPENING HOURS -->
    <!-- ====================================================== -->

    <TextView
        android:id="@+id/tvOpenHours"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginTop="5dp"

        android:text="Open Mon-Fri 08:00-19:00"

        android:textSize="13sp"

        android:textColor="#777777" />


    <!-- ====================================================== -->
    <!-- VIEW PHARMACY BUTTON -->
    <!-- ====================================================== -->

    <Button
        android:id="@+id/btnViewPharmacy"

        android:layout_width="match_parent"
        android:layout_height="48dp"

        android:layout_marginTop="14dp"

        android:text="View Pharmacy on Google Maps"

        android:textSize="14sp"
        android:textStyle="bold"

        android:textColor="#FFFFFF"

        android:backgroundTint="#159A8C" />

</LinearLayout>