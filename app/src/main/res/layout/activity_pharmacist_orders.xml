<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F9F8">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="20dp"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/btnBackOrders"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="‹"
            android:textSize="34sp"
            android:textColor="#176B48"
            android:contentDescription="Back"
            android:paddingEnd="20dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pharmacy Orders"
                android:textSize="23sp"
                android:textStyle="bold"
                android:textColor="#173D2C"/>

            <TextView
                android:id="@+id/tvPharmacyName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loading pharmacy..."
                android:textSize="13sp"
                android:textColor="#74847C"/>

        </LinearLayout>
    </LinearLayout>

    <!-- Order count -->
    <TextView
        android:id="@+id/tvOrderCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="12dp"
        android:text="Orders"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#173D2C"/>

    <!-- Loading indicator -->
    <ProgressBar
        android:id="@+id/ordersProgressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="20dp"
        android:visibility="gone"/>

    <!-- Empty state -->
    <TextView
        android:id="@+id/tvNoOrders"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="30dp"
        android:gravity="center"
        android:text="No orders found"
        android:textColor="#74847C"
        android:textSize="16sp"
        android:visibility="gone"/>

    <!-- Real orders from MySQL -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerPharmacyOrders"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp"
        android:clipToPadding="false"/>

    <!-- Existing reusable pharmacist navigation -->
    <include
        layout="@layout/pharmacist_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

</LinearLayout>
