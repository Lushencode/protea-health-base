<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="24dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tvQuestionPageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Community Q&amp;A"
            android:textSize="27sp"
            android:textStyle="bold"
            android:textColor="#222222"/>

        <TextView
            android:id="@+id/tvQuestionPageSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Ask questions, share experiences and get advice from healthcare professionals."
            android:textSize="14sp"
            android:lineSpacingExtra="2dp"
            android:textColor="#777777"/>

    </LinearLayout>


    <!-- Search Questions -->
    <EditText
        android:id="@+id/etSearchQuestions"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="8dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:hint="Search questions..."
        android:textSize="14sp"
        android:textColor="#222222"
        android:textColorHint="#999999"
        android:singleLine="true"
        android:inputType="text"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:drawablePadding="10dp"
        android:background="@drawable/bg_search_bar"/>


    <!-- Ask Question Button -->
    <Button
        android:id="@+id/btnAskQuestion"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="12dp"
        android:text="+ Ask a Question"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#E85D75"/>


    <!-- Section Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/tvLatestQuestions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Latest Questions"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#222222"/>

        <TextView
            android:id="@+id/tvQuestionCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12 questions"
            android:textSize="12sp"
            android:textColor="#159A8C"/>

    </LinearLayout>


    <!-- Questions -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvQuestions"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="20dp"
        android:clipToPadding="false"
        android:scrollbars="vertical"/>

</LinearLayout>