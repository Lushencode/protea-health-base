<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F5F0"
    android:fillViewport="true"
    tools:context=".Patient.EmergencyActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- CALL EMERGENCY -->
        <LinearLayout
            android:id="@+id/cardCallEmergency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_red"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="28dp"
            android:paddingEnd="28dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.25"
                android:text="ONE TAP · WORKS LOCKED"
                android:textColor="#FFF1EF"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-black"
                android:lineSpacingMultiplier="0.85"
                android:text="Call\nEmergency"
                android:textColor="#FFFFFF"
                android:textSize="44sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:text="112 mobile · 10177 ambulance"
                android:textColor="#FFF1EF"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- AMBULANCE DIRECT -->
        <TextView
            android:id="@+id/cardAmbulance"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_white"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="Ambulance directly — 10177"
            android:textColor="#1A1612"
            android:textSize="15sp" />

        <!-- PRIMARY CONTACT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_block"
            android:backgroundTint="#CCCCCC"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.2"
                    android:text="PRIMARY CONTACT"
                    android:textColor="#5C3D00"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvContactName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Thandi Nkosi"
                    android:textColor="#1A1612"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvContactDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="monospace"
                    android:text="Spouse · +27 82 555 0148"
                    android:textColor="#1A1612"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnCallContact"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:background="@drawable/bg_dark_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="76dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="Call"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- MEDICAL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_white"
            android:orientation="vertical"
            android:padding="20dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:fontFamily="sans-serif-medium"
                    android:text="Medical"
                    android:textColor="#1A1612"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEdit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.2"
                    android:padding="4dp"
                    android:text="EDIT"
                    android:textColor="#CCCCCC"
                    android:textSize="11sp" />
            </RelativeLayout>

            <!-- Conditions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_block"
                android:backgroundTint="#E3F4EC"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.2"
                    android:text="CONDITIONS"
                    android:textColor="#0B7A55"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvConditions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif"
                    android:text="Type 2 diabetes · Asthma"
                    android:textColor="#1A1612"
                    android:textSize="17sp" />
            </LinearLayout>

            <!-- Allergies -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_block"
                android:backgroundTint="#E3F4EC"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.2"
                    android:text="ALLERGIES"
                    android:textColor="#0B7A55"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvAllergies"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif"
                    android:text="Penicillin · Peanuts"
                    android:textColor="#1A1612"
                    android:textSize="19sp" />
            </LinearLayout>


            <!-- Medications -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_block"
                android:backgroundTint="#E3F4EC"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.2"
                    android:text="MEDICATIONS"
                    android:textColor="#0B7A55"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvMedications"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif"
                    android:text="Metformin 500mg · Aspirin 75mg"
                    android:textColor="#1A1612"
                    android:textSize="17sp" />
            </LinearLayout>


        </LinearLayout>

    </LinearLayout>

</ScrollView>

    <include
        android:id="@+id/patientBottomNav"
        layout="@layout/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />

</FrameLayout>
