<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvDeliveryOrderId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Order #23"
                android:textColor="#17324D"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvDeliveryStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Confirmed"
                android:textColor="#2563EB"
                android:textStyle="bold"
                android:textSize="13sp"
                android:padding="8dp"
                android:background="#EFF6FF"/>

        </LinearLayout>

        <TextView
            android:id="@+id/tvDeliveryPatient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Patient: Example Patient"
            android:textColor="#334155"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/tvDeliveryMedication"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Medication: Sleep"
            android:textColor="#334155"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/tvDeliveryQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Quantity: 30"
            android:textColor="#334155"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/tvDeliveryAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Delivery address"
            android:textColor="#475569"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/tvDeliveryFee"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Delivery fee: R0.00"
            android:textColor="#475569"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/tvDeliveryDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Order date"
            android:textColor="#64748B"
            android:textSize="12sp"/>

        <Button
            android:id="@+id/btnUpdateDeliveryStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Update Delivery Status"
            android:textAllCaps="false"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>
