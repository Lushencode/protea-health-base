<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8F9F9"
    tools:context=".Collection">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:background="@drawable/rounded_light_button"
                android:src="@android:drawable/ic_menu_revert"
                android:contentDescription="Back"
                android:padding="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Medication Order"
                    android:textColor="#111111"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Upload, review and order your medication"
                    android:textColor="#777777"
                    android:textSize="14sp"
                    android:layout_marginTop="3dp" />

            </LinearLayout>

        </LinearLayout>


        <!-- PRESCRIPTION SECTION -->


        <!-- MEDICATION LIST -->

        <LinearLayout
            android:id="@+id/prescriptionCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/white_card"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Prescription"
                android:textColor="#111111"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="18dp"
                android:text="Add your medication manually or upload a photo of your prescription."
                android:textColor="#777777"
                android:textSize="14sp" />


            <!-- TAKE / UPLOAD PRESCRIPTION -->

            <Button
                android:id="@+id/uploadPrescriptionButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="#0B5D4B"
                android:text="📷  Take / Upload Prescription"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/prescriptionImage"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="15dp"
                android:background="#EEEEEE"
                android:contentDescription="Prescription photo"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <TextView
                android:id="@+id/prescriptionStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="No prescription uploaded"
                android:textColor="#888888"
                android:textSize="13sp" />


            <!-- AI ANALYSIS -->

            <LinearLayout
                android:id="@+id/aiAnalysisSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:background="#F3F8F6"
                android:orientation="vertical"
                android:padding="15dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI Prescription Check"
                    android:textColor="#0B5D4B"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/aiAnalysisText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Checking your prescription..."
                    android:textColor="#555555"
                    android:textSize="13sp" />

            </LinearLayout>


            <!-- MANUAL MEDICATION -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Add medication manually"
                android:textColor="#222222"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/medicationNameInput"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/input_background"
                android:hint="Medication name"
                android:padding="14dp"
                android:textColor="#111111"
                android:textColorHint="#999999" />

            <EditText
                android:id="@+id/dosageInput"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/input_background"
                android:hint="Dosage e.g. 500mg"
                android:padding="14dp"
                android:textColor="#111111"
                android:textColorHint="#999999" />

            <EditText
                android:id="@+id/quantityInput"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/input_background"
                android:hint="Quantity"
                android:inputType="number"
                android:padding="14dp"
                android:textColor="#111111"
                android:textColorHint="#999999" />

            <Button
                android:id="@+id/addMedicationButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="#E4F1ED"
                android:text="+ Add Medication"
                android:textColor="#0B5D4B"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/medicationListCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/white_card"
            android:padding="20dp"
            android:layout_marginTop="15dp"
            android:elevation="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your Medication"
                android:textColor="#111111"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/noMedicationText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No medication added yet."
                android:textColor="#888888"
                android:textSize="14sp"
                android:gravity="center"
                android:padding="20dp" />

            <!-- Dynamically add medication rows here -->

            <LinearLayout
                android:id="@+id/medicationList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>


        <!-- PHARMACY -->

        <LinearLayout
            android:id="@+id/pharmacyCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/white_card"
            android:padding="20dp"
            android:layout_marginTop="15dp"
            android:elevation="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Choose Pharmacy"
                android:textColor="#111111"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Choose where you would like to collect your medication."
                android:textColor="#777777"
                android:textSize="14sp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="15dp" />

            <Spinner
                android:id="@+id/pharmacySpinner"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/input_background" />

            <TextView
                android:id="@+id/pharmacyAvailability"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select a pharmacy to check availability."
                android:textColor="#777777"
                android:textSize="13sp"
                android:layout_marginTop="10dp" />

        </LinearLayout>

        <!-- COLLECTION / DELIVERY -->

        <LinearLayout
            android:id="@+id/receivingCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/white_card"
            android:padding="20dp"
            android:layout_marginTop="15dp"
            android:elevation="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="How would you like to receive it?"
                android:textColor="#111111"
                android:textSize="18sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/medicationMethodGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <RadioButton
                    android:id="@+id/collectionRadio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Collection"
                    android:textColor="#222222"
                    android:buttonTint="#0B5D4B" />

                <RadioButton
                    android:id="@+id/deliveryRadio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Delivery"
                    android:textColor="#222222"
                    android:buttonTint="#F05A91"
                    android:layout_marginStart="20dp" />

            </RadioGroup>


            <!-- DELIVERY ADDRESS -->

            <LinearLayout
                android:id="@+id/deliverySection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Delivery address"
                    android:textColor="#222222"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginTop="15dp" />

                <EditText
                    android:id="@+id/addressInput"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_marginTop="7dp"
                    android:hint="Enter your delivery address"
                    android:gravity="top"
                    android:padding="14dp"
                    android:background="@drawable/input_background"
                    android:textColor="#111111"
                    android:textColorHint="#999999"
                    android:inputType="textMultiLine|textCapSentences" />

            </LinearLayout>

        </LinearLayout>

        <!-- ORDER SUMMARY -->

        <LinearLayout
            android:id="@+id/orderSummaryCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/white_card"
            android:padding="20dp"
            android:layout_marginTop="15dp"
            android:elevation="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Order Summary"
                android:textColor="#111111"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="15dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Medication total"
                    android:textColor="#555555"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/medicationTotalText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="R0.00"
                    android:textColor="#111111"
                    android:textStyle="bold"
                    android:textSize="14sp" />

            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Delivery fee"
                    android:textColor="#555555"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/deliveryFeeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="R0.00"
                    android:textColor="#111111"
                    android:textSize="14sp" />

            </LinearLayout>


            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#DDDDDD"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="15dp" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Total"
                    android:textColor="#111111"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/orderTotalText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="R0.00"
                    android:textColor="#0B5D4B"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>


        <!-- CONFIRM / CANCEL -->

        <Button
            android:id="@+id/confirmButton"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Confirm Order"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="#009688"
            android:layout_marginTop="20dp" />

        <Button
            android:id="@+id/cancelButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Cancel Order"
            android:textColor="#F05A91"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="#FCEEF3"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="30dp" />

    </LinearLayout>

</ScrollView>