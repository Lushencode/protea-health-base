<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC"
    android:padding="0dp">

    <TextView
        android:id="@+id/tvDeliveryTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Delivery Management"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#17324D"
        android:layout_marginBottom="6dp"/>

    <TextView
        android:id="@+id/tvDeliverySubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manage and track medication deliveries"
        android:textSize="14sp"
        android:textColor="#64748B"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnRefreshDeliveries"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Refresh Deliveries"
        android:textAllCaps="false"/>

    <ProgressBar
        android:id="@+id/deliveryProgressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="24dp"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/tvEmptyDeliveries"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No delivery orders found"
        android:textSize="15sp"
        android:textColor="#64748B"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPharmacyDeliveries"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"/>

    <include layout="@layout/pharmacist_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">


    </include>

</LinearLayout>
