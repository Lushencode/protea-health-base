<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="18dp"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:layout_marginBottom="14dp"
    android:background="@drawable/question_card_background">

    <!-- User information -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Profile circle -->
        <TextView
            android:id="@+id/tvQuestionAvatar"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="N"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/avatar_background"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvQuestionUser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Patient"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#222222"/>

            <TextView
                android:id="@+id/tvQuestionDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="2 hours ago"
                android:textSize="12sp"
                android:textColor="#888888"/>

        </LinearLayout>

        <!-- Question tag -->
        <TextView
            android:id="@+id/tvQuestionTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="Question"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#159A8C"
            android:background="@drawable/question_tag_background"/>

    </LinearLayout>

    <!-- Question title -->
    <TextView
        android:id="@+id/tvQuestionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Can I take my medication with food?"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#222222"/>

    <!-- Question description -->
    <TextView
        android:id="@+id/tvQuestionDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="I usually take my medication in the morning and wanted to know if I should eat before taking it."
        android:textSize="14sp"
        android:lineSpacingExtra="2dp"
        android:textColor="#666666"
        android:maxLines="4"
        android:ellipsize="end"/>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        android:background="#EEEEEE"/>

    <!-- Bottom actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Comments -->
        <LinearLayout
            android:id="@+id/layoutComments"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_dialog_email"
                android:tint="#159A8C"
                android:contentDescription="Comments"/>

            <TextView
                android:id="@+id/tvCommentCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="3 Comments"
                android:textSize="13sp"
                android:textColor="#555555"/>

        </LinearLayout>

        <!-- Spacer -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <!-- Doctor answered -->
        <LinearLayout
            android:id="@+id/layoutDoctorAnswer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/online_dot"/>

            <TextView
                android:id="@+id/tvDoctorAnswer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Doctor answered"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#159A8C"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>