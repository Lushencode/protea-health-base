<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7FAF9"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="Protea Health logo"
                android:src="@drawable/project_logo_mark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Doctor dashboard"
                android:textColor="#0C514A"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Today's overview"
            android:textColor="#F7FAF9"
            android:textSize="19sp"
            android:textStyle="bold"
            android:background="@drawable/bg_home_banner"
            android:gravity="center_vertical"
            android:minHeight="76dp"
            android:padding="18dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTodayAppointmentsCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_home_card"
                android:gravity="center"
                android:minHeight="90dp"
                android:padding="12dp"
                android:text="—\nAppointments today"
                android:textColor="#111111"
                android:textSize="15sp"
                android:backgroundTint="#DDF2F0"/>

            <TextView
                android:id="@+id/tvFollowUpsCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_home_card"
                android:gravity="center"
                android:minHeight="90dp"
                android:padding="12dp"
                android:text="—\nFollow-ups needed"
                android:textColor="#111111"
                android:backgroundTint="#FFF0DF"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Upcoming appointments"
            android:textColor="#111111"
            android:textSize="19sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/appointmentsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:background="@android:color/transparent"
            android:padding="0dp">

            <TextView
                android:id="@+id/tvAppointmentsEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No appointments to display yet."
                android:textColor="#444444"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Priority follow-ups"
            android:textColor="#111111"
            android:textSize="19sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/followUpsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:background="@android:color/transparent"
            android:padding="0dp">

            <TextView
                android:id="@+id/tvFollowUpsEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No follow-ups to display yet."
                android:textColor="#444444"
                android:textSize="15sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSearchPatients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:minHeight="48dp"
            android:text="Search patients"
            android:backgroundTint="#0C514A"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"/>

        <Button
            android:id="@+id/btnHealthHub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="Manage health hub"
            android:backgroundTint="#159EA5"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"/>

    </LinearLayout>
</ScrollView>