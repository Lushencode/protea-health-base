<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F8F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:background="@drawable/rounded_light_button"
                android:src="@android:drawable/ic_menu_revert"
                android:contentDescription="Back"
                android:padding="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Appointments"
                    android:textColor="#111111"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Manage your healthcare journey"
                    android:textColor="#777777"
                    android:textSize="14sp"
                    android:layout_marginTop="3dp" />

            </LinearLayout>

        </LinearLayout>


        <!-- APPOINTMENT CARD -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/white_card"
            android:padding="20dp"
            android:elevation="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Book an appointment"
                android:textColor="#111111"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Choose a service and tell us when you would like to visit."
                android:textColor="#777777"
                android:textSize="14sp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="20dp" />


            <!-- APPOINTMENT TYPE -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Appointment type"
                android:textColor="#222222"
                android:textStyle="bold"
                android:textSize="14sp" />

            <Spinner
                android:id="@+id/appointmentTypeSpinner"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/input_background" />


            <!-- HEALTHCARE FACILITY -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Healthcare facility"
                android:textColor="#222222"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginTop="18dp" />

            <EditText
                android:id="@+id/facilityInput"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:hint="Clinic, hospital or practice"
                android:background="@drawable/input_background"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#111111"
                android:textColorHint="#999999"
                android:inputType="textCapSentences" />


            <!-- DATE -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Preferred date"
                android:textColor="#222222"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginTop="18dp" />


            <!-- TIME -->

            <EditText
                android:id="@+id/dateInput"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/input_background"
                android:clickable="true"
                android:focusable="false"
                android:hint="Select date"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#111111"
                android:textColorHint="#999999" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Preferred time"
                android:textColor="#222222"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginTop="18dp" />

            <EditText
                android:id="@+id/timeInput"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:hint="Select time"
                android:focusable="false"
                android:clickable="true"
                android:background="@drawable/input_background"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#111111"
                android:textColorHint="#999999" />


            <!-- REASON -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reason for appointment"
                android:textColor="#222222"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginTop="18dp" />

            <EditText
                android:id="@+id/reasonInput"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginTop="7dp"
                android:hint="Briefly describe what you need help with"
                android:gravity="top"
                android:padding="14dp"
                android:background="@drawable/input_background"
                android:textColor="#111111"
                android:textColorHint="#999999"
                android:inputType="textMultiLine|textCapSentences" />


            <!-- CONFIRM / SUBMIT BUTTON -->

            <Button
                android:id="@+id/confirmButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:background="#0B5D4B"
                android:text="Book Appointment"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>



    </LinearLayout>

</ScrollView>
