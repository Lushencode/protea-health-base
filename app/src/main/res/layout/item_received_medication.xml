<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#F5F8FC"
    android:padding="16dp"
    android:layout_marginBottom="12dp"
    android:elevation="2dp">

    <TextView
        android:id="@+id/tvReceivedMedicationName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Paracetamol 500mg"
        android:textColor="#17365D"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp"/>

    <TextView
        android:id="@+id/tvReceivedPharmacyName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pharmacy: Protea Pharmacy"
        android:textColor="#333333"
        android:textSize="14sp"
        android:layout_marginBottom="6dp"/>

    <TextView
        android:id="@+id/tvReceivedQuantity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Quantity received: 2"
        android:textColor="#333333"
        android:textSize="14sp"
        android:layout_marginBottom="6dp"/>

    <TextView
        android:id="@+id/tvReceivedOrderId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Order #12"
        android:textColor="#555555"
        android:textSize="13sp"
        android:layout_marginBottom="6dp"/>

    <TextView
        android:id="@+id/tvReceivedDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Received: 8 October 2026"
        android:textColor="#777777"
        android:textSize="12sp"/>

</LinearLayout>
