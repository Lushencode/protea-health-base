<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Order ID and status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvRecentOrderId"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Order #1052"
            android:textColor="#17324D"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRecentOrderStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#E0F2F1"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:text="PROCESSING"
            android:textColor="#00695C"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Medication -->
    <TextView
        android:id="@+id/tvRecentOrderMedication"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Medication: Panado"
        android:textColor="#555555"
        android:textSize="14sp" />

    <!-- Patient -->
    <TextView
        android:id="@+id/tvRecentOrderPatient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Patient: Example Patient"
        android:textColor="#555555"
        android:textSize="14sp" />

    <!-- Date -->
    <TextView
        android:id="@+id/tvRecentOrderDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="2026-10-08"
        android:textColor="#888888"
        android:textSize="12sp" />

    <!-- Separator -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:background="#E5E7EB" />

</LinearLayout>
